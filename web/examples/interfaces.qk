// Interfaces are implementation-strict: the method set and signatures must match,
// the interface name itself is never part of the comparison.
type interface { fn area(Self self) int; } Shape;

type struct { int w; int h; } Rect;
type struct { int side; } Square;

impl {
    fn area(Rect self) int {
        return self.w * self.h;
    }
} Rect;

impl {
    fn area(Square self) int {
        return self.side * self.side;
    }
} Square;

fn describe(Shape s) int {
    return s.area();
}

fn main(IOStream io) void {
    Rect r = .{w: 3, h: 4};
    Square q = .{side: 5};
    io.println("rect =", describe(r));
    io.println("square =", describe(q));
}
